# Copy to .env (or configure via `dotnet user-secrets` for local development)
# Never commit real secrets to source control.

ConnectionStrings__DefaultConnection=Server=localhost;Database=GymIdentityDb;Trusted_Connection=True;TrustServerCertificate=True
JwtSettings__SecretKey=REPLACE_WITH_AT_LEAST_32_CHAR_RANDOM_SECRET_KEY
Cors__AllowedOrigins__0=http://localhost:5173
