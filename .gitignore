# ==========================================
# .NET / C# (Backend)
# ==========================================
# Build outputs
**/[Bb]in/
**/[Oo]bj/
**/[Oo]ut/

# Visual Studio & VS Code cache / user settings
.vs/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.user
*.userosscache
*.suo
*.userprefs
*.sln.docstates

# Rider / JetBrains
.idea/
*.sln.iml

# Test Results & Code Coverage
[Tt]est[Rr]esults/
*.coverage
*.coveragexml

# NuGet
packages/
*.nupkg
project.lock.json
project.assets.json

# Secrets & local config (uncomment if you keep secrets in appsettings)
# **/appsettings.Development.json
# **/appsettings.Local.json


# ==========================================
# React / Node.js (Frontend)
# ==========================================
# Dependencies
**/node_modules/
**/.pnp
**/.pnp.js

# Production build outputs
**/dist/
**/build/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Environment variables & local secrets
**/.env
**/.env.local
**/.env.development.local
**/.env.test.local
**/.env.production.local

# Editor & linter cache
**/.eslintcache
**/.stylelintcache
.npm/
.yarn/cache/


# ==========================================
# OS & Miscellaneous
# ==========================================
Thumbs.db
ehthumbs.db
[Dd]esktop.ini
.DS_Store
*.swp
*~
