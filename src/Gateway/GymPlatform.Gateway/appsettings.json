{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "identity-auth-route": {
        "ClusterId": "identity-cluster",
        "Match": {
          "Path": "/api/auth/{**catch-all}"
        }
      },
      "identity-user-route": {
        "ClusterId": "identity-cluster",
        "Match": {
          "Path": "/api/user/{**catch-all}"
        }
      },
      "members-route": {
        "ClusterId": "members-cluster",
        "Match": {
          "Path": "/api/members/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "identity-cluster": {
        "Destinations": {
          "identity-api": {
            "Address": "http://localhost:5256"
          }
        }
      },
      "members-cluster": {
        "Destinations": {
          "members-api": {
            "Address": "http://localhost:5295"
          }
        }
      }
    }
  }
}
